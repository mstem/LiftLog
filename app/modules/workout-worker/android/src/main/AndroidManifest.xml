<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wake the CPU to ding exactly when a rest is over, even with the screen off /
         the device in Doze. USE_EXACT_ALARM (API 33+) is auto-granted and not
         user-revocable; SCHEDULE_EXACT_ALARM covers Android 12 (auto-granted there). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <service
            android:name=".WorkoutWorkerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout tracking from a persistent notification but we don't need to read any sensors so the type HEALTH can not apply" />
        </service>
        <receiver
            android:name=".RestAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
